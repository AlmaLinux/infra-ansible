# {{ ansible_managed }}
#
# Generated from lumina_env; see roles/lumina/vars/main.yml, and change it
# there. systemd reads this through EnvironmentFile= in lumina.service and in
# every maintenance timer.
#
# Values are double-quoted with \ and " escaped, which is the form systemd's
# parser round-trips exactly. Nothing shell-sources this file - the role's
# handlers pass the same dict to manage.py as a real environment - so the
# quoting only has to satisfy systemd, and a secret containing $, ) or a quote
# arrives at Django as itself.
{% for key, value in lumina_env | dictsort %}
{{ key }}="{{ value | string | replace('\\', '\\\\') | replace('"', '\\"') }}"
{% endfor %}
