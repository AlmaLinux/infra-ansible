# {{ ansible_managed }}
[Unit]
Description=Deliver queued Lumina notifications (email + webhooks) from the outbox
After=network.target

[Service]
Type=oneshot
User={{ lumina_user }}
Group={{ lumina_group }}
EnvironmentFile=/etc/lumina.env
WorkingDirectory={{ lumina_app_dir }}
ExecStart={{ lumina_venv }}/bin/python manage.py deliver_notifications
