# {{ ansible_managed }}
[Unit]
Description=Prune bundle files from old rejected Lumina certification runs
After=network.target

[Service]
Type=oneshot
User={{ lumina_user }}
Group={{ lumina_group }}
EnvironmentFile=/etc/lumina.env
WorkingDirectory={{ lumina_app_dir }}
ExecStart={{ lumina_venv }}/bin/python manage.py prune_run_bundles
