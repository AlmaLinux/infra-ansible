---
# {{ ansible_managed }}
# Schema: https://github.com/AlmaLinux/mirror-mirage/blob/{{ almalinux_repo_mirror_mirage_version }}/packaging/secrets.example.yaml
# Top-level keys MUST match the CDN names in config.yaml.
# Driven by `almalinux_repo_mirror_mirage_secrets` in host_vars (Vault-backed).
#
# service_account_file_contents is stripped here: it's a helper key we use to
# write the GCP service-account JSON to service_account_file on disk, not part
# of the mirror-mirage secrets schema.
{% set cleaned = {} %}
{% for name, creds in almalinux_repo_mirror_mirage_secrets.items() %}
{%   set _ = cleaned.update({name: creds | dict2items | rejectattr('key', 'equalto', 'service_account_file_contents') | items2dict}) %}
{% endfor %}
{{ cleaned | to_nice_yaml(indent=2) }}
