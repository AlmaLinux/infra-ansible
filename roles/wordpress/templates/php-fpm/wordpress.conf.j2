; {{ ansible_managed }}
[wordpress]
user = {{ wordpress_user }}
group = {{ wordpress_group }}

listen = {{ wordpress_php_fpm_socket }}
listen.owner = nginx
listen.group = nginx
listen.mode = 0660

pm = dynamic
pm.max_children = {{ wordpress_php_fpm_max_children }}
pm.start_servers = {{ wordpress_php_fpm_start_servers }}
pm.min_spare_servers = {{ wordpress_php_fpm_min_spare_servers }}
pm.max_spare_servers = {{ wordpress_php_fpm_max_spare_servers }}
pm.max_requests = 500

; Wall clock, unlike max_execution_time below
request_terminate_timeout = {{ wordpress_request_timeout }}

; To the journal (journalctl -t php). The distro's /var/log/php-fpm is
; writable by apache only, and this pool does not run as apache.
php_admin_value[error_log] = syslog
php_admin_flag[log_errors] = on

php_value[session.save_handler] = files
php_value[session.save_path] = {{ wordpress_php_session_dir }}

; php_value, not php_admin_value: WordPress raises the memory and time limits
; itself for updates and imports, and an admin value would refuse it.
php_value[memory_limit] = {{ wordpress_php_memory_limit }}
php_value[max_execution_time] = {{ wordpress_request_timeout }}
php_value[upload_max_filesize] = {{ wordpress_upload_max_mb }}M
php_value[post_max_size] = {{ wordpress_upload_max_mb }}M
